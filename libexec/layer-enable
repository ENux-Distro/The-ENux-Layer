#!/bin/sh
# layer-enable - make a layer's rootfs usable in a chroot/non-PID-1 environment
#
# Usage: layer-enable <name>
#
# Bind-mounts the layer onto itself so it gets its own /proc/self/mountinfo
# entry (without this, tools like pacman that walk mountinfo to find a
# path's mountpoint fail with bogus "no space" errors - see commit history
# for the reproduction), then rbinds the global paths (/proc, /sys, /dev,
# /home, /root, /tmp, /mnt, /media, /srv, /run...) from the host so a cross
# command sees the caller's cwd, and copies resolv.conf for DNS.
#
# Idempotent: running this twice on an already-enabled layer is a no-op.

set -eu

LAYER_DIR="${LAYER_DIR:-/enux/layer}"

if [ "$#" -ne 1 ]; then
    echo "usage: layer-enable <name>" >&2
    exit 2
fi

name="$1"
root="$LAYER_DIR/$name"

if [ ! -d "$root" ]; then
    echo "layer-enable: '$name' is not installed at $root" >&2
    exit 1
fi

is_mounted()
{
    # Match "<mountpoint> " as a whole field in mountinfo, not a substring,
    # so /enux/layer/arch doesn't false-match /enux/layer/arch2.
    awk -v p="$1" '$5 == p { found=1 } END { exit !found }' /proc/self/mountinfo
}

# mount(1) prints a "your fstab has been modified, run systemctl daemon-reload"
# hint on every call when /etc/fstab's mtime is newer than systemd's last
# reload (e.g. a future-dated fstab from a skewed install clock). It is pure
# noise for our internal binds, so drop just that hint while preserving real
# errors and the exit status.
do_mount()
{
    if _e=$(mount "$@" 2>&1 1>/dev/null); then _rc=0; else _rc=$?; fi
    if [ -n "$_e" ]; then
        printf '%s\n' "$_e" | grep -viE 'hint|daemon-reload|fstab' >&2 || true
    fi
    return "$_rc"
}

bind_if_needed()
{
    src="$1"
    dst="$2"
    if is_mounted "$dst"; then
        return 0
    fi
    do_mount --bind "$src" "$dst"
}

# Self-bind first - everything else depends on $root having a mountinfo
# entry of its own. Without --make-private, the self-bind stays in the
# same propagation group as the underlying root mount, so every bind we
# do underneath it (proc, sys, dev...) gets propagated back through both
# paths to the same directory and shows up twice in mountinfo.
bind_if_needed "$root" "$root"
do_mount --make-private "$root"

# Global paths, the same in every layer, so a cross command finds the caller's
# cwd and files. Recursive so submounts (/dev/pts, /run/user/<uid>) come
# along; rslave so later host mounts (a USB stick in /media) show up here
# without layer mounts leaking back to the host.
rbind_if_needed()
{
    [ -d "$1" ] || return 0
    mkdir -p "$2"
    is_mounted "$2" && return 0
    do_mount --rbind "$1" "$2"
    do_mount --make-rslave "$2"
}

for gd in proc sys dev home root tmp var/tmp mnt media srv run; do
    rbind_if_needed "/$gd" "$root/$gd"
done
[ "${ENUX_SHARE_GLOBAL:-0}" = 1 ] && rbind_if_needed /opt "$root/opt"

# Not recursive: the layers under /enux/layer carry their own submounts, and
# pulling them in would nest every layer inside every other one.
if [ -d /enux ]; then
    mkdir -p "$root/enux"
    bind_if_needed /enux "$root/enux"
fi

# DNS: copy a real resolv.conf into the layer for the chroot session.
# Many distros ship /etc/resolv.conf as a symlink (Fedora -> /run/systemd/
# resolve/stub-resolv.conf). If we don't remove that first, cp follows the
# dangling symlink and writes through an absolute target resolved against
# the HOST root - the layer ends up with no working resolver, and we've
# scribbled on the host's /run. Replace it with a plain file instead.
if [ -e /etc/resolv.conf ] || [ -L /etc/resolv.conf ]; then
    rm -f "$root/etc/resolv.conf"
    cp -L /etc/resolv.conf "$root/etc/resolv.conf" 2>/dev/null || true
fi

# Hostname resolution: the layer's own /etc/hosts and /etc/hostname don't know
# the base's hostname, so anything that resolves it (sudo, X) warns/fails with
# "unable to resolve host <name>". Copy the base's in so the layer agrees.
for hf in /etc/hostname /etc/hosts; do
    [ -e "$hf" ] && cp -L "$hf" "$root$hf" 2>/dev/null || true
done

